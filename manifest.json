    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ],
  "shortcuts": [
    {
      "name": "Découvrir",
      "short_name": "Discover",
      "description": "Découvrir de nouvelles musiques",
      "url": "/discover",
      "icons": [
        {
          "src": "/icons/discover-96x96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Top Charts",
      "short_name": "Charts",
      "description": "Voir le top des charts",
      "url": "/top-charts",
      "icons": [
        {
          "src": "/icons/charts-96x96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Artistes",
      "short_name": "Artists",
      "description": "Explorer les artistes",
      "url": "/top-artists",
      "icons": [
        {
          "src": "/icons/artists-96x96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-discover.png",
      "sizes": "720x1280",
      "type": "image/png",
      "platform": "mobile",
      "label": "Page de découverte sur mobile"
    },
    {
      "src": "/screenshots/desktop-discover.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "platform": "wide",
      "label": "Page de découverte sur desktop"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+diabaratv",
      "url": "/?action=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "audio/*": [".mp3", ".wav", ".ogg", ".m4a"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*"]
        }
      ]
    }
  }
}